def compute_retrieval_probs(
    q_emb: np.ndarray,
    doc_embs: np.ndarray,
    sigma: float = 1.0,
    eps: float = 1e-12
) -> np.ndarray:
   
    if q_emb.ndim != 1:
        q_emb = q_emb.ravel()
    # squared Euclidean distances
    # careful: compute in a numerically stable vectorized way
    diffs = doc_embs - q_emb  # shape (N, D)
    sq_dists = np.sum(diffs * diffs, axis=1)  # shape (N,)

    # kernel exponent: -sq_dist / (2 * sigma^2)
    denom = 2.0 * (sigma ** 2)
    exps = np.exp(-sq_dists / (denom + eps))

    # normalize to probabilities
    sump = np.sum(exps)
    if sump <= 0.0:
        # fallback: uniform
        probs = np.ones_like(exps) / len(exps)
    else:
        probs = exps / sump
    return probs



def retrieve_docs(
    query: str,
    docs: List[Tuple[str, str]],
    sigma: float = 1.0,
    k: int = 5,
    strategy: str = "topk",
    return_probs: bool = False
) -> List[Tuple[str, str, float]]:
    """
    Retrieve k documents for the query using distance-sensitive probabilities.

    Inputs:
      query: text query
      docs: list of tuples (doc_id, doc_text)
      sigma: uncertainty parameter
      k: number of docs to return
      strategy: "topk" (deterministic) or "sample" (stochastic sampling without replacement)
      return_probs: if True, include probability with each returned doc

    Returns:
      list of (doc_id, doc_text, prob) tuples (prob present if return_probs True)
    """
    if len(docs) == 0 or k <= 0:
        return []

    # Get embeddings
    q_emb = embed_query(query)  # shape (D,)
    doc_texts = [t for (_id, t) in docs]
    doc_embs = embed_documents(doc_texts)  # shape (N, D)

    # Ensure shapes
    if doc_embs.ndim != 2:
        raise ValueError("doc_embs must be 2D array (N, D)")

    probs = compute_retrieval_probs(q_emb, doc_embs, sigma=sigma)

    N = len(docs)
    k = min(k, N)

    results = []
    if strategy == "topk":
        idxs = np.argsort(-probs)[:k]  # highest probabilities
    elif strategy == "sample":
        # sample without replacement weighted by probs
        # if probs has zeros or extremely small values, np.random.choice handles it
        idxs = np.random.choice(np.arange(N), size=k, replace=False, p=probs)
    else:
        raise ValueError("strategy must be 'topk' or 'sample'")

    for i in idxs:
        doc_id = docs[i][0]
        doc_text = docs[i][1]
        if return_probs:
            results.append((doc_id, doc_text, float(probs[i])))
        else:
            results.append((doc_id, doc_text, float(probs[i])))
    return results



def build_rag_prompt(query: str, retrieved: List[Tuple[str, str, float]], max_snippet_len: Optional[int] = 1000) -> str:
    """
    Simple aggregator: prepend retrieved doc snippets to the query.
    Trim long docs if desired.
    """
    pieces = []
    for doc_id, doc_text, prob in retrieved:
        snippet = doc_text if max_snippet_len is None else doc_text[:max_snippet_len]
        pieces.append(f"[Doc {doc_id} | p={prob:.4f}]\n{snippet}\n---\n")
    pieces.append(f"User query: {query}\nAnswer:")
    return "\n".join(pieces)



